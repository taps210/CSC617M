// test_const_array.hd
// Tests const declarations, array allocation, and array element read/write.

const MAX = 5;
const GREETING = "Hello";

// Returns the sum 1 + 2 + ... + n using a local array
int sumArray(int n) {
    int arr[5];
    int i = 0;
    int total = 0;
    while (i < n) {
        arr[i] = i + 1;
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        total = total + arr[i];
        i = i + 1;
    }
    return total;
}

void main() {
    // const values are readable like normal variables
    print(GREETING);           // expected: Hello
    print(MAX);                // expected: 5

    // sumArray(MAX) = 1+2+3+4+5 = 15
    int result = sumArray(MAX);
    print(result);             // expected: 15

    // Direct array manipulation
    int data[3];
    data[0] = 10;
    data[1] = 20;
    data[2] = 30;
    int sum = data[0] + data[1] + data[2];
    print(sum);                // expected: 60
}
