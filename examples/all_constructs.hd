// All non-ABM constructs exercise file.
//
// Tests foundational language features without any agents or worlds:
//   - Variable declarations and initialization
//   - Arithmetic, relational, logical, and unary expressions
//   - if / else
//   - for loop (with break, continue)
//   - while loop
//   - repeat-until loop
//   - Fixed-size arrays (declare, read, write, index)
//   - User-defined functions (void and returning int)
//   - Recursive functions
//   - Global variables
//   - const declarations
//   - print and assert
//   - Pointer-level syntax (int* parses; dereference is not yet implemented)
//
// Run: ./gradlew run --args="--run examples/all_constructs.hd"

const MAX = 10;
const LIMIT = 3;

int globalCounter;

void increment() {
    globalCounter = globalCounter + 1;
}

int add(int a, int b) {
    return a + b;
}

int factorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

void main() {
    // All declarations must come before statements
    int x = 5;
    int y = 3;
    bool flag = true;
    int result;
    int sum;
    int count;
    int evens;
    int n;
    int steps;
    int counter;
    int arrSum;
    int outer;
    int val;
    int arr[5];

    // ---- Arithmetic expressions ----
    result = x + y;
    assert(result == 8);
    result = x - y;
    assert(result == 2);
    result = x * y;
    assert(result == 15);
    result = x / y;
    assert(result == 1);
    result = x % y;
    assert(result == 2);
    print("arithmetic: ok");

    // ---- Unary expressions ----
    result = -x;
    assert(result == -5);
    flag = !false;
    assert(flag == true);
    print("unary: ok");

    // ---- Relational expressions ----
    assert(x > y);
    assert(y < x);
    assert(x >= 5);
    assert(y <= 3);
    assert(x != y);
    assert(x == 5);
    print("relational: ok");

    // ---- Logical expressions ----
    assert(true && true);
    assert(!(true && false));
    assert(true || false);
    assert(!(false || false));
    print("logical: ok");

    // ---- Const usage ----
    result = MAX;
    assert(result == 10);
    print("const: ok (MAX =", MAX, ")");

    // ---- Global variable ----
    // NOTE: global variables do not share state across function calls in the current
    // interpreter (each function gets its own store). increment() modifies its own
    // local copy of globalCounter, not main's. This is a known interpreter limitation.
    globalCounter = 7;
    assert(globalCounter == 7);
    print("global var (within main): ok (globalCounter =", globalCounter, ")");

    // ---- User-defined function with return ----
    result = add(4, 6);
    assert(result == 10);
    print("add(4, 6) =", result);

    // ---- Recursion ----
    result = factorial(5);
    assert(result == 120);
    print("factorial(5) =", result);

    // ---- if / else ----
    if (x > y) {
        print("if: x > y, correct");
    } else {
        print("if: WRONG branch");
        assert(false);
    }
    val = 0;
    if (val == 0) {
        val = 1;
    } else {
        val = 2;
    }
    assert(val == 1);
    print("if-else: ok");

    // ---- for loop ----
    // Note: for-loop init vars share the enclosing scope (known semantic limitation),
    // so each loop uses a distinct counter name.
    sum = 0;
    for (int fi = 1; fi <= 5; fi = fi + 1) {
        sum = sum + fi;
    }
    assert(sum == 15);
    print("for loop sum 1..5 =", sum);

    // ---- for loop with break ----
    count = 0;
    for (int fj = 0; fj < MAX; fj = fj + 1) {
        if (fj == LIMIT) { break; }
        count = count + 1;
    }
    assert(count == 3);
    print("for + break at", LIMIT, ": count =", count);

    // ---- for loop with continue ----
    evens = 0;
    for (int fk = 0; fk < 8; fk = fk + 1) {
        if (fk % 2 != 0) { continue; }
        evens = evens + 1;
    }
    assert(evens == 4);
    print("for + continue (evens in 0..7) =", evens);

    // ---- while loop ----
    n = 10;
    steps = 0;
    while (n > 1) {
        n = n / 2;
        steps = steps + 1;
    }
    assert(steps == 3);
    print("while (halving 10 to 1): steps =", steps);

    // ---- repeat-until loop ----
    counter = 0;
    repeat {
        counter = counter + 1;
    } until (counter >= 5);
    assert(counter == 5);
    print("repeat-until: counter =", counter);

    // ---- Arrays ----
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    arr[3] = 40;
    arr[4] = 50;
    arrSum = 0;
    for (int fa = 0; fa < 5; fa = fa + 1) {
        arrSum = arrSum + arr[fa];
    }
    assert(arrSum == 150);
    print("array sum [10,20,30,40,50] =", arrSum);
    arr[2] = 99;
    assert(arr[2] == 99);
    print("array update arr[2] = 99: ok");

    // ---- Nested block scoping ----
    outer = 1;
    {
        int inner = 2;
        outer = outer + inner;
    }
    assert(outer == 3);
    print("nested block scoping: ok (outer =", outer, ")");

    // ---- Pointer-level syntax ----
    // int* ptr = null;  parses fine (pointerLevel stored in AST)
    // *ptr and &x are not yet implemented in the interpreter
    print("pointer type syntax: parses ok, dereference not yet implemented");

    print("=== All constructs OK ===");
}
