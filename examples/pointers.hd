// Comprehensive Pointer Type Tests
// Tests: allocation, field access, multiple pointers, reference counting, GC, debugger display

// Point acts as a simple record type: three int fields
agent Point {
    int x;
    int y;
    int z;

    update {}
}

// Counter acts as a simple record type: one int field
agent Counter {
    int value;

    update {}
}

// Test 1: Basic pointer allocation and field assignment
void test1BasicAllocation() {
    Point* ptr;
    {
        print("=== Test 1: Basic Allocation ===");
        ptr = new Point();
        ptr->x = 5;
        print(ptr->x);  // Should print 5
    }
}

// Test 2: Multiple pointers to same object
void test2MultiplePointers() {
    Point* a;
    Point* b;
    {
        print("=== Test 2: Multiple Pointers ===");
        a = new Point();
        a->x = 10;
        b = a;
        print(b->x);  // Should print 10
        b->x = 20;
        print(a->x);  // Should print 20 (same object)
    }
}

// Test 3: Multiple independent objects
void test3MultipleObjects() {
    Point* obj1;
    Point* obj2;
    {
        print("=== Test 3: Multiple Independent Objects ===");
        obj1 = new Point();
        obj2 = new Point();
        obj1->x = 100;
        obj2->x = 200;
        print(obj1->x);  // Should print 100
        print(obj2->x);  // Should print 200
    }
}

// Test 4: Reassignment (garbage collection)
void test4Reassignment() {
    Point* a;
    {
        print("=== Test 4: Reassignment (GC) ===");
        a = new Point();
        a->x = 111;
        print(a->x);  // Should print 111
        a = new Point();
        a->x = 222;
        print(a->x);  // Should print 222
    }
}

// Test 5: Multiple field updates
void test5FieldUpdates() {
    Point* ptr;
    {
        print("=== Test 5: Field Updates ===");
        ptr = new Point();
        ptr->x = 1;
        ptr->y = 2;
        ptr->z = 3;
        print(ptr->x);
        print(ptr->y);
        print(ptr->z);
        ptr->x = 10;
        ptr->y = 20;
        ptr->z = 30;
        print(ptr->x);
        print(ptr->y);
        print(ptr->z);
    }
}

// Test 6: Pointer fields in arithmetic expressions
void test6Arithmetic() {
    Point* ptr;
    int sum;
    {
        print("=== Test 6: Arithmetic with Pointer Fields ===");
        ptr = new Point();
        ptr->x = 5;
        ptr->y = 3;
        sum = ptr->x + ptr->y;
        print(sum);         // Should print 8
        ptr->x = ptr->x * 2;
        print(ptr->x);      // Should print 10
    }
}

// Test 7: Pointer fields in conditionals
void test7Conditionals() {
    Counter* c;
    {
        print("=== Test 7: Conditionals with Pointer Fields ===");
        c = new Counter();
        c->value = 100;
        if (c->value > 50) {
            print(1);  // Should print 1
        } else {
            print(0);
        }
        c->value = 25;
        if (c->value > 50) {
            print(1);
        } else {
            print(0);  // Should print 0
        }
    }
}

// Test 8: Pointer fields in loops
void test8Loops() {
    Counter* c;
    int i;
    {
        print("=== Test 8: Loops with Pointer Fields ===");
        c = new Counter();
        c->value = 0;
        i = 0;
        while (i < 5) {
            c->value = c->value + 1;
            i = i + 1;
        }
        print(c->value);  // Should print 5
    }
}

void main() {
    test1BasicAllocation();
    test2MultiplePointers();
    test3MultipleObjects();
    test4Reassignment();
    test5FieldUpdates();
    test6Arithmetic();
    test7Conditionals();
    test8Loops();
    print("=== All Tests Completed ===");
}
