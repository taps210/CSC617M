// Zone Behavior Test
//
// Verifies that zone blocks execute correctly:
//   - A zone condition is checked after update() each step
//   - If the condition is true, the zone block runs
//   - If the condition is false, the zone block is skipped
//
// Setup:
//   - Guard agent has an energy field that decreases each step
//   - zone alert(energy < 30, Player) triggers when energy drops below 30
//     and prints a warning each step it remains true
//   - zone critical(energy < 10, Player) triggers when energy drops below 10
//     and destroys the guard
//
// Expected output:
//   Steps 1-4:  no zone output  (energy 45→30, condition < 30 is false)
//   Steps 5-9:  [zone alert] fires (energy 25→5, condition < 30 is true)
//   Step 10:    [zone critical] also fires when energy drops below 10 and guard is destroyed
//
// Run: ./gradlew run --args="--run examples/Example05_Zone.hd"

agent Player {
    int x, y;
    update {}
}

agent Guard {
    int x, y;
    int energy = 50;

    zone alert(energy < 30, Player) {
        print("  [zone alert] Guard energy low! energy =", energy);
    }

    zone critical(energy < 10, Player) {
        print("  [zone critical] Guard exhausted, destroying. energy =", energy);
        destroy(self);
    }

    update {
        energy = energy - 5;
        print("  [Guard] update energy =", energy);
    }
}

world Arena {
    int width = 10;
    int height = 10;
    bool spawned = false;
    int tick = 0;

    pre {
        if (!spawned) {
            spawn Guard(5, 5);
            spawn Player(0, 0);
            spawned = true;
            print("[World] Guard (energy=50) and Player spawned.");
            print("[World] Zone alert fires when energy < 30, critical when < 10.");
        }
    }

    post {
        tick = tick + 1;
        print("[post] tick =", tick, "(if Guard is gone, no [Guard] lines above)");
    }
}

void main() {
    int steps = 0;
    print("=== Zone Test ===");
    repeat {
        step();
        steps = steps + 1;
    } until (steps >= 12);
    print("=== Done. Ran", steps, "steps ===");
}
