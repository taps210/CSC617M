// ERROR TEST 2: Null pointer dereference (runtime error)
void testNullDereference() {
    Drop* ptr;
    {
        print("=== Null Dereference Test (expect runtime error) ===");
        ptr = null;
        ptr->x = 5;  // Runtime error: "Null pointer dereference"
        print("This should not print");
    }
}

