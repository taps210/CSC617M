// Predator-Prey Ecosystem: Wolves hunt Deer on an open plain.
//
// Uses toroidal (wraparound) boundaries so agents stay on the grid:
//   move((self.x + dx + W) % W, (self.y + dy + H) % H)
// Without this, random walk scatters agents across an infinite plane
// and they never encounter each other.
//
// Run: ./gradlew run --args="--run examples/Example02_PredatorPrey.hd"

agent Deer {
    int x, y;
    int age = 0;

    update {
        // Wrap around grid edges (W=20, H=20)
        move((self.x + rand(-1, 1) + 20) % 20, (self.y + rand(-1, 1) + 20) % 20);
        age = age + 1;
        if (age > 30) {
            destroy(self);
        }
    }
}

agent Wolf {
    int x, y;
    int energy = 50;
    int age = 0;
    Wolf nearby[];

    update {
        // Wolves move faster than deer
        move((self.x + rand(-2, 2) + 20) % 20, (self.y + rand(-2, 2) + 20) % 20);
        energy = energy - 1;
        age = age + 1;

        nearby = neighbors(self, 2);
        if (nearby.length > 0) {
            destroy(nearby[0]);
            energy = energy + 5;
            print("  [x] Wolf kill (energy:", energy, ")");
        }

        if (energy > 75) {
            spawn Wolf(self.x, self.y);
            energy = energy - 40;
            print("  [+] Wolf born");
        }

        if (energy <= 0 || age > 80) {
            destroy(self);
            print("  [-] Wolf died (energy:", energy, "age:", age, ")");
        }
    }
}

world Plain {
    int width = 20;
    int height = 20;
    bool spawned = false;
    int tick = 0;

    pre {
        if (!spawned) {
            for (int i = 0; i < 20; i = i + 1) {
                spawn Deer(rand(0, 19), rand(0, 19));
            }
            for (int j = 0; j < 4; j = j + 1) {
                spawn Wolf(rand(0, 19), rand(0, 19));
            }
            spawned = true;
            print("[World] 20 Deer, 4 Wolves on a 20x20 toroidal grid");
        }
    }

    post {
        tick = tick + 1;
        if (tick % 4 == 0) {
            spawn Deer(rand(0, 19), rand(0, 19));
            spawn Deer(rand(0, 19), rand(0, 19));
            spawn Deer(rand(0, 19), rand(0, 19));
        }
        if (tick % 25 == 0) {
            print("--- Tick", tick, "---");
        }
    }
}

void main() {
    int steps = 0;
    print("=== Predator-Prey Simulation Starting ===");
    repeat {
        step();
        steps = steps + 1;
    } until (steps > 200);
    print("=== Done. Ran", steps, "steps ===");
}
