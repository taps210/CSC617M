// Demo: Optimization #3 Dead Temp Assignment Elimination
// Run:
//   ./gradlew run --args="--ir --opt-trace tests/rubric/opt_demo_03_dead_temp_elim.hd"
// What to point at in the trace:
//   AFTER #1 constant folding turns t? = t? + t? into t? = <const>
//   which often makes the original literal temps unused.
//   AFTER #3 then removes those now-dead temp assignments.

void main() {
    // Decls before statements
    int x;
    int y;

    // These literals typically become dead temps after folding:
    x = 1 + 2;
    y = (3 + 4) + (5 + 6);

    print("x=", x, " y=", y);
}
