// Expected: Semantic error (rand expects 0, 1, or 2 arguments)

agent A {
    int x, y;
    int r;

    update {
        r = rand(1, 2, 3); // too many args
        move(self.x, self.y);
    }
}

world W {
    bool spawned = false;
    pre {
        if (!spawned) {
            spawn A(0, 0);
            spawned = true;
        }
    }
    post {}
}

void main() {
    step();
}
